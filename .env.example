# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/agenda_julyana
DB_USERNAME=postgres
DB_PASSWORD=change-me

# JWT
JWT_SECRET_BASE64=change-me
JWT_EXPIRATION_MINUTES=1440

# Google OAuth
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
GOOGLE_FRONTEND_CALLBACK=http://localhost:5173/auth/callback

# SMTP
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=change-me
MAIL_PASSWORD=change-me

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=change-me
MERCADOPAGO_BASE_URL=https://api.mercadopago.com
# Somente para o sandbox. Nao usar em producao.
MERCADOPAGO_TEST_PAYER_EMAIL=

# Bootstrap do primeiro administrador.
# Habilite somente na primeira inicializacao de um ambiente sem ADMIN.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=

# WhatsApp — Baileys gateway (provider padrao)
WHATSAPP_PROVIDER=baileys
BAILEYS_BASE_URL=https://SEU-GATEWAY-BAILEYS.onrender.com
BAILEYS_API_TOKEN=change-me

# Alternativa de rollback para WPPConnect
WPP_CONNECT_BASE_URL=http://localhost:21465
WPP_CONNECT_TOKEN=
WPP_CONNECT_SESSION=agenda-julyana

# WhatsApp Cloud API (somente se WHATSAPP_PROVIDER=meta)
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
